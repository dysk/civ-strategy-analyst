<%= link_to "&laquo; #{@game.name}".html_safe, game_path(@game), class: "back-link" %>

<h1>Analyses</h1>
<p class="subtitle"><%= @game.name %> &mdash; <%= pluralize(@analyses.size, "analysis", plural: "analyses") %></p>

<table>
  <thead>
    <tr>
      <th>Generated</th>
      <th>Model</th>
      <th>Usage</th>
    </tr>
  </thead>
  <tbody>
    <% @analyses.each do |analysis| %>
      <tr>
        <td><%= link_to analysis.created_at.strftime("%Y-%m-%d %H:%M"), game_analysis_path(@game, analysis) %></td>
        <td><%= analysis.model %></td>
        <td class="meta">
          <% if analysis.input_tokens && analysis.output_tokens %>
            <%= analysis.input_tokens %> in + <%= analysis.output_tokens %> out
            <% if analysis.cost_usd %>
              (~$<%= format("%.4f", analysis.cost_usd) %>)
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
