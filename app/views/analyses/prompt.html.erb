<%= link_to "&laquo; Analysis".html_safe, game_analysis_path(@game, @analysis), class: "back-link" %>

<h1>Prompt Snapshot</h1>
<p class="subtitle">
  <%= @game.name %> &middot; <%= @analysis.model %> &middot;
  generated <%= @analysis.created_at.strftime("%Y-%m-%d %H:%M") %>
</p>

<pre class="prompt-snapshot"><%= @analysis.prompt %></pre>
