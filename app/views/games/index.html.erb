<h1>Games</h1>

<% if @games.empty? %>
  <p>No games imported yet. Run <code>bin/civ import path.jsonl</code>.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Game</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @games.each do |game| %>
        <tr>
          <td><%= link_to game.name, game_path(game) %></td>
          <td>
            <%= game.analyses.exists? ? "analyzed" : "not analyzed" %>
            <%= "(completed)" if game.completed? %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
