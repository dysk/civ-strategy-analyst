<h1>Games</h1>
<p class="subtitle">Imported Civilization 5 + LEKMOD games.</p>

<% if @games.empty? %>
  <p class="empty-state">No games imported yet. Run <code>bin/civ import path.jsonl</code>.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Game</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% @games.each do |game| %>
        <tr>
          <td><%= link_to game.name, game_path(game) %></td>
          <td>
            <% if game.analyses.exists? %>
              <span class="badge badge--analyzed">analyzed</span>
            <% else %>
              <span class="badge">not analyzed</span>
            <% end %>
            <% if game.completed? %>
              <span class="badge">completed</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
