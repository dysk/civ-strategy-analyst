<%= link_to "&laquo; All games".html_safe, games_path, class: "back-link" %>

<h1><%= @game.name %></h1>
<p class="subtitle">
  <%= @game.map_script %> &middot; <%= @game.map_size %> &middot; <%= @game.game_speed %> &middot;
  max turns: <%= @game.max_turns %>
</p>
<p><%= link_to "View raw event data", game_events_path(@game) %></p>

<h2>Outcome</h2>
<p>
  <% if @outcome[:victory_type] == "scrapped" %>
    <strong>Scrapped</strong> &mdash; abandoned by vote, no winner
    <span class="badge"><%= outcome_source_label(@outcome[:source]) %></span>
  <% elsif @outcome[:winner_civ] %>
    <strong><%= outcome_winner_names(@game, @outcome) %></strong>
    <%= "(#{@outcome[:victory_type]})" if @outcome[:victory_type] %>
    <span class="badge"><%= outcome_source_label(@outcome[:source]) %></span>
  <% else %>
    No leader yet.
  <% end %>
  <span class="badge<%= " badge--analyzed" unless @outcome[:in_progress] %>">
    <%= @outcome[:in_progress] ? "in progress" : "complete" %>
  </span>
</p>

<h2>Final Standings</h2>
<% if @standings.empty? %>
  <p class="empty-state">No snapshots yet.</p>
<% else %>
  <ol>
    <% @standings.each do |civ| %>
      <li><%= civ %></li>
    <% end %>
  </ol>
<% end %>

<%= section_heading("Capital Distances", "capital-distances") %>
<% if @capital_positions.any? %>
  <svg class="capital-layout" viewBox="0 0 <%= @capital_layout_width %> <%= @capital_layout_height %>" role="img" aria-label="Capital positions and buffer cities">
    <% @corridor_segments.each do |segment| %>
      <line class="corridor" x1="<%= segment[:x1] %>" y1="<%= segment[:y1] %>" x2="<%= segment[:x2] %>" y2="<%= segment[:y2] %>" />
    <% end %>
    <% @capital_positions.each do |point| %>
      <g class="<%= point[:major] ? "capital--major" : "capital--minor" %><%= " map-civ-#{point[:colour_slot]}" if point[:colour_slot] %>">
        <circle cx="<%= point[:cx] %>" cy="<%= point[:cy] %>" r="<%= point[:major] ? 7 : 4 %>" />
        <text x="<%= point[:cx] %>" y="<%= point[:cy] - 12 %>"><%= point[:civ] %></text>
      </g>
    <% end %>
    <% @buffer_positions.each do |point| %>
      <g class="buffer-city<%= " map-civ-#{point[:colour_slot]}" if point[:colour_slot] %>">
        <circle cx="<%= point[:cx] %>" cy="<%= point[:cy] %>" r="4" />
        <text x="<%= point[:cx] %>" y="<%= point[:cy] - 9 %>"><%= point[:city] %></text>
      </g>
    <% end %>
  </svg>
<% end %>

<%= section_heading("Strategy Report", "strategy-report") %>
<% if @latest_analysis %>
  <p class="meta">
    Model: <%= @latest_analysis.model %> &middot; generated <%= @latest_analysis.created_at.strftime("%Y-%m-%d %H:%M") %>
    <% if @latest_analysis.input_tokens && @latest_analysis.output_tokens %>
      &middot; <%= @latest_analysis.input_tokens %> in + <%= @latest_analysis.output_tokens %> out tokens
      <% if @latest_analysis.cost_usd %>
        (~$<%= format("%.4f", @latest_analysis.cost_usd) %>)
      <% end %>
    <% end %>
  </p>
  <p><%= link_to "View all #{pluralize(@game.analyses.count, "analysis", plural: "analyses")}", game_analyses_path(@game) %></p>
  <div class="report"><%= render_markdown(@latest_analysis.report) %></div>
<% else %>
  <p class="empty-state">Not analyzed yet. Run <code>bin/civ analyze <%= @game.id %></code>.</p>
<% end %>

<% if @capital_distances.empty? %>
  <p class="empty-state">No capital coordinates in this game's events.</p>
<% else %>
  <details class="disclosure">
    <summary>Capital distances table</summary>
    <table class="capital-distances">
      <thead>
        <tr>
          <th>Civ</th>
          <th>Civ</th>
          <th>Hexes apart</th>
        </tr>
      </thead>
      <tbody>
        <% @capital_distances.each do |pair| %>
          <tr>
            <td><%= pair[:civs].first %></td>
            <td><%= pair[:civs].last %></td>
            <td><%= pair[:distance] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @map_bounds.estimated? %>
      <p><span class="badge">map width estimated</span> distances across the map's edge may be shorter than shown</p>
    <% end %>
  </details>
<% end %>

<% if !@buffer_cities[:applicable] %>
  <p class="empty-state">Buffer cities are only computed for Pangaea maps.</p>
<% elsif @buffer_cities[:pairs].empty? %>
  <p class="empty-state">No two capitals started within <%= @buffer_cities[:neighbour_distance] %> hexes, so no buffer cities.</p>
<% else %>
  <details class="disclosure">
    <summary>Buffer cities table</summary>
    <p class="note">
      Founded by turn <%= @buffer_cities[:window_turn] %>; neighbours within
      <%= @buffer_cities[:neighbour_distance] %> hexes, corridor city up to
      <%= @buffer_cities[:lateral_tolerance] %> hexes off the line between them.
    </p>
    <table class="buffer-cities">
      <thead>
        <tr>
          <th>Pair</th>
          <th>Apart</th>
          <th>Civ</th>
          <th>Buffer</th>
          <th>Founded</th>
          <th>City #</th>
          <th>Capital pop</th>
          <th>Reach before</th>
          <th>Detour</th>
          <th>From own</th>
          <th>From rival</th>
        </tr>
      </thead>
      <tbody>
        <% @buffer_cities[:pairs].each do |pair| %>
          <% pair[:civs].each_with_index do |civ, index| %>
            <% buffer = pair[:buffers][civ] %>
            <tr>
              <% if index.zero? %>
                <% span = pair[:civs].size %>
                <td rowspan="<%= span %>"><%= pair[:civs].first %> &ndash; <%= pair[:civs].last %></td>
                <td rowspan="<%= span %>"><%= pair[:distance] %></td>
              <% end %>
              <td><%= civ %></td>
              <td><%= buffer&.dig(:city) || "&mdash;".html_safe %></td>
              <td>
                <%= buffer&.dig(:turn) || "&mdash;".html_safe %>
                <% if pair[:settled_first] == civ %>
                  <span class="badge">first</span>
                <% end %>
              </td>
              <td><%= buffer&.dig(:order) || "&mdash;".html_safe %></td>
              <td><%= buffer&.dig(:capital_population) || "&mdash;".html_safe %></td>
              <td><%= buffer&.dig(:reach_before) || "&mdash;".html_safe %></td>
              <td><%= buffer&.dig(:detour) || "&mdash;".html_safe %></td>
              <td><%= buffer&.dig(:from_own_capital) || "&mdash;".html_safe %></td>
              <td><%= buffer&.dig(:from_rival_capital) || "&mdash;".html_safe %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
    <% @buffer_cities[:priority].each do |civ, rivals| %>
      <p><%= civ %> secured its corridors in this order: <%= rivals.join(", ") %>.</p>
    <% end %>
  </details>
<% end %>

<% if @geometry_rows.empty? %>
  <p class="empty-state">No city coordinates, so no empire geometry.</p>
<% else %>
  <details class="disclosure">
    <summary>Empire geometry table</summary>
    <table class="geometry">
      <thead>
        <tr>
          <th>Civ</th>
          <th>Cities</th>
          <th>Span</th>
          <th>Spacing</th>
          <th>Elongation</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @geometry_rows.each do |row| %>
          <tr>
            <td><%= row[:civ] %></td>
            <td><%= row[:cities] %></td>
            <td><%= row[:span] || "&mdash;".html_safe %></td>
            <td><%= row[:mean_spacing] || "&mdash;".html_safe %></td>
            <td><%= row[:elongation] || "&mdash;".html_safe %></td>
            <td>
              <% if row[:mismatch] %>
                <span class="badge">approximate from turn <%= row[:mismatch][:turn] %></span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p><%= link_to "See how these shapes came about", game_geometry_path(@game) %></p>
  </details>
<% end %>

<%= section_heading("Early Game", "early-game") %>
<% if @early_game_rows.empty? %>
  <p class="empty-state">No players in this game.</p>
<% else %>
  <p class="note">Deadline: turn <%= @early_game_deadline_turn %> (<%= @game.game_speed %>).</p>
  <table class="early-game">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Ends Turn</th>
        <th>Why</th>
        <th>Milestone</th>
        <th>Tech</th>
        <th>Building</th>
      </tr>
    </thead>
    <tbody>
      <% @early_game_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:end_turn] %></td>
          <td><%= row[:reason] %></td>
          <td><%= early_game_milestone(row) || "&mdash;".html_safe %></td>
          <td><%= row[:tech_turn] || "&mdash;".html_safe %></td>
          <td><%= row[:building_turn] || "&mdash;".html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= section_heading("Wonder Races", "wonder-races") %>
<% if !@wonder_races[:applicable] %>
  <p class="empty-state">Wonder races need per-city snapshots, which this game's log does not carry.</p>
<% elsif @wonder_races[:races].empty? %>
  <p class="empty-state">No world wonder in this game was contested by more than one city.</p>
<% else %>
  <p class="note">
    A race is every world wonder more than one city was building. A contender
    <strong>lost</strong> it if still building on the turn it fell, and
    <strong>abandoned</strong> it if it had moved on earlier.
  </p>
  <table class="wonder-races">
    <thead>
      <tr>
        <th>Wonder</th>
        <th>Done</th>
        <th>Won by</th>
        <th>Finish</th>
        <th>Lost by</th>
        <th>Turns on it</th>
        <th>Production in</th>
        <th>Turns left</th>
        <th>Outcome</th>
      </tr>
    </thead>
    <tbody>
      <% @wonder_races[:races].each do |race| %>
        <% race[:contenders].each_with_index do |contender, index| %>
          <tr>
            <% if index.zero? %>
              <% span = race[:contenders].size %>
              <td rowspan="<%= span %>"><%= race[:wonder_name] %></td>
              <td rowspan="<%= span %>"><%= race[:completed_turn] %></td>
              <td rowspan="<%= span %>"><%= race[:winner][:civ] %> (<%= race[:winner][:city] %>)</td>
              <td rowspan="<%= span %>"><%= race[:winner_finish].to_s.tr("_", " ") %></td>
            <% end %>
            <td><%= contender[:civ] %> (<%= contender[:city] %>)</td>
            <td><%= contender[:turns_building] %></td>
            <td><%= contender[:production_invested] %></td>
            <td><%= contender[:turns_left_when_last_seen] || "&mdash;".html_safe %></td>
            <td><%= contender[:outcome] %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= section_heading("Military", "military") %>
<% if @army_rows.empty? %>
  <p class="empty-state">No military data in this game's snapshots.</p>
<% else %>
  <table class="army">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Turn</th>
        <th>Units</th>
        <th>Might</th>
        <th>Power</th>
        <th>Power per unit</th>
      </tr>
    </thead>
    <tbody>
      <% @army_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:turn] %></td>
          <td><%= row[:units] || "&mdash;".html_safe %></td>
          <td><%= row[:might] || "&mdash;".html_safe %></td>
          <td><%= row[:army_power] || "&mdash;".html_safe %></td>
          <td><%= row[:power_per_unit] || "&mdash;".html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See how these armies were built", game_army_path(@game) %></p>
<% end %>

<%= section_heading("Cultural Standing", "cultural-standing") %>
<% if @cultural_rows.empty? %>
  <p class="empty-state">No tourism data in this game's snapshots.</p>
<% else %>
  <table class="cultural">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Tourism</th>
        <th>Civs Influential On</th>
        <th>Influential/Dominant On</th>
      </tr>
    </thead>
    <tbody>
      <% @cultural_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:tourism] || "&mdash;".html_safe %></td>
          <td><%= row[:civs_influential_on] || "&mdash;".html_safe %></td>
          <td><%= row[:influential_on].presence&.join(", ") || "&mdash;".html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See how cultural standing changed over time", game_cultural_path(@game) %></p>
<% end %>

<%= section_heading("World Congress", "world-congress") %>
<% if @congress_summary.nil? %>
  <p class="empty-state">No World Congress data in this game's events.</p>
<% else %>
  <p class="meta">
    Host: <strong><%= @congress_summary[:host] || "none yet" %></strong>
    &middot; Votes needed for diplomatic victory: <strong><%= @congress_summary[:votes_needed] || "unknown" %></strong>
  </p>
  <table class="congress">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Delegate Votes</th>
      </tr>
    </thead>
    <tbody>
      <% @congress_summary[:rows].each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:votes] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See host changes, votes and resolutions over time", game_congress_path(@game) %></p>
<% end %>

<%= section_heading("Victory Progress", "victory-progress") %>
<% if @victory_progress_rows.empty? %>
  <p class="empty-state">No domination or space-race data in this game's snapshots.</p>
<% else %>
  <table class="victory-progress">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Capitals Held</th>
        <th>Spaceship Parts</th>
      </tr>
    </thead>
    <tbody>
      <% @victory_progress_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:capitals_held] || "&mdash;".html_safe %></td>
          <td><%= row[:parts_assembled] ? "#{row[:parts_assembled]} / 6" : "&mdash;".html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See capitals and spaceship assembly over time", game_victory_progress_path(@game) %></p>
<% end %>

<%= section_heading("Espionage", "espionage") %>
<% if @espionage_rows.empty? %>
  <p class="empty-state">No espionage activity in this game's events.</p>
<% else %>
  <table class="espionage">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Spies Made</th>
        <th>Spies Lost</th>
        <th>Missions</th>
        <th>Garrisoned</th>
      </tr>
    </thead>
    <tbody>
      <% @espionage_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:made] %></td>
          <td><%= row[:lost] %></td>
          <td><%= row[:missions] %></td>
          <td><%= row[:garrisoned] ? "Yes" : "No" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See how the spies moved", game_espionage_path(@game) %></p>
<% end %>

<%= section_heading("Diplomatic Ties", "diplomatic-ties") %>
<% if @diplomatic_tie_rows.empty? %>
  <p class="empty-state">No embassy, open borders, friendship, pact or trade agreement recorded in this game's events.</p>
<% else %>
  <table class="diplomatic-ties">
    <thead>
      <tr>
        <th>Civs</th>
        <th>Type</th>
        <th>From</th>
        <th>To</th>
      </tr>
    </thead>
    <tbody>
      <% @diplomatic_tie_rows.each do |row| %>
        <tr>
          <td><%= row[:civs].join(" &ndash; ").html_safe %></td>
          <td><%= row[:type].tr("_", " ") %></td>
          <td><%= row[:from_turn] %></td>
          <td><%= row[:to_turn] || "ongoing" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= section_heading("Trade Routes", "trade-routes") %>
<% if @trade_route_destination_rows.empty? %>
  <p class="empty-state">No trade route activity in this game's events.</p>
<% else %>
  <table class="trade-routes">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Own (food)</th>
        <th>Own (production)</th>
        <th>To City-States</th>
        <th>To Majors</th>
      </tr>
    </thead>
    <tbody>
      <% @trade_route_destination_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:own_food] || 0 %></td>
          <td><%= row[:own_production] || 0 %></td>
          <td><%= row[:city_state] %></td>
          <td><%= row[:major] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @trade_route_one_sided_rows.any? %>
    <h3>One-Sided Routes</h3>
    <p class="note">A civ feeding a rival's gold, science or tourism without ever seeing a return.</p>
    <table class="trade-routes-one-sided">
      <thead>
        <tr>
          <th>Civ</th>
          <th>Other Civ</th>
          <th>Route</th>
          <th>Turn</th>
          <th>Yield</th>
          <th>Civ's Cut</th>
          <th>Other's Cut</th>
        </tr>
      </thead>
      <tbody>
        <% @trade_route_one_sided_rows.each do |row| %>
          <tr>
            <td><%= row[:civ] %></td>
            <td><%= row[:other_civ] %></td>
            <td><%= row[:from_city] %> &rarr; <%= row[:to_city] %></td>
            <td><%= row[:turn] %></td>
            <td><%= row[:yield] %></td>
            <td><%= row[:civ_value] %></td>
            <td><%= row[:other_civ_value] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<%= section_heading("Religion", "religion") %>
<% if @religion_hold_rows.empty? %>
  <p class="empty-state">No city religious conversions in this game's events.</p>
<% else %>
  <table class="religion-holds">
    <thead>
      <tr>
        <th>Civ</th>
        <th>City</th>
        <th>Religion</th>
        <th>From</th>
        <th>To</th>
        <th>Settled</th>
      </tr>
    </thead>
    <tbody>
      <% @religion_hold_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:city] %></td>
          <td><%= religion_name(row[:religion]) %></td>
          <td><%= row[:from_turn] %></td>
          <td><%= row[:to_turn] %></td>
          <td><%= row[:settled] ? "Yes" : "No" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <h3>Missionary and Inquisitor Use</h3>
  <table class="religion-uses">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Missionary Uses</th>
        <th>Inquisitor Uses</th>
      </tr>
    </thead>
    <tbody>
      <% @religion_use_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:missionary_uses] %></td>
          <td><%= row[:inquisitor_uses] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= section_heading("Yield Attribution", "yield-attribution") %>
<% if @yield_attribution_rows.empty? %>
  <p class="empty-state">No yield source breakdown in this game's snapshots.</p>
<% else %>
  <p class="note">Latest checkpoint per civ and yield. Shortfall is the reported total minus the named sources.</p>
  <table class="yield-attribution">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Yield</th>
        <th>Turn</th>
        <th>Total</th>
        <th>Sources</th>
        <th>Shortfall</th>
      </tr>
    </thead>
    <tbody>
      <% @yield_attribution_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:yield_name] %></td>
          <td><%= row[:turn] %></td>
          <td><%= row[:total] %></td>
          <td><%= row[:sources].map { |source, value| "#{source}: #{value}" }.join(", ") %></td>
          <td><%= row[:shortfall] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= section_heading("Resource Shortages", "resource-shortages") %>
<% if @resource_shortage_rows.empty? %>
  <p class="empty-state">No strategic resource deficits in this game's snapshots.</p>
<% else %>
  <p class="note">A computed exposure to LEKMOD's combat penalty, never an observed loss.</p>
  <table class="resource-shortages">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Turn</th>
        <th>Resource</th>
        <th>Total</th>
        <th>Used</th>
        <th>Deficit</th>
        <th>Penalty</th>
        <th>Exposed Units</th>
      </tr>
    </thead>
    <tbody>
      <% @resource_shortage_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:turn] %></td>
          <td><%= resource_name(row[:resource]) %></td>
          <td><%= row[:total] %></td>
          <td><%= row[:used] %></td>
          <td><%= number_to_percentage(row[:deficit_fraction] * 100, precision: 1) %></td>
          <td><%= row[:penalty] %></td>
          <td><%= row[:exposed_units].map { |unit| unit_name(unit) }.join(", ") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= section_heading("Deals", "deals") %>
<% if @deal_match_rows.empty? && @deal_unattributed_import_rows.empty? %>
  <p class="empty-state">No resource import/export data in this game's snapshots.</p>
<% else %>
  <p class="note">Inferred from import/export co-occurrence, never an observed CvDeal.</p>
  <table class="deals">
    <thead>
      <tr>
        <th>Resource</th>
        <th>Exporter</th>
        <th>Importer</th>
        <th>From</th>
        <th>To</th>
      </tr>
    </thead>
    <tbody>
      <% @deal_match_rows.each do |row| %>
        <tr>
          <td><%= resource_name(row[:resource]) %></td>
          <td><%= row[:exporter] %></td>
          <td><%= row[:importer] %></td>
          <td><%= row[:from_turn] %></td>
          <td><%= row[:to_turn] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @deal_unattributed_import_rows.any? %>
    <h3>Unattributed Imports</h3>
    <p class="note">An import with no major exporting the same resource the same turn - most likely a city-state ally's gift.</p>
    <table class="deals-unattributed">
      <thead>
        <tr>
          <th>Civ</th>
          <th>Resource</th>
          <th>Turn</th>
          <th>Amount</th>
        </tr>
      </thead>
      <tbody>
        <% @deal_unattributed_import_rows.each do |row| %>
          <tr>
            <td><%= row[:civ] %></td>
            <td><%= resource_name(row[:resource]) %></td>
            <td><%= row[:turn] %></td>
            <td><%= row[:amount] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<%= section_heading("City-States", "city-states") %>
<% if @city_state_trait_rows.empty? %>
  <p class="empty-state">No city-state snapshots in this game's events.</p>
<% else %>
  <table class="city-state-traits">
    <thead>
      <tr>
        <th>City-State</th>
        <th>Trait</th>
        <th>Personality</th>
        <th>Unique Unit</th>
      </tr>
    </thead>
    <tbody>
      <% @city_state_trait_rows.each do |row| %>
        <tr>
          <td><%= row[:city_state] %></td>
          <td><%= minor_civ_trait_name(row[:trait]) %></td>
          <td><%= minor_civ_personality_name(row[:personality]) %></td>
          <td><%= row[:unique_unit] ? unit_name(row[:unique_unit]) : "&mdash;".html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <h3>Alliances</h3>
  <table class="city-state-alliances">
    <thead>
      <tr>
        <th>Civ</th>
        <th>City-State</th>
        <th>From</th>
        <th>Until</th>
        <th>Origin</th>
      </tr>
    </thead>
    <tbody>
      <% @city_state_alliance_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:city_state] %></td>
          <td><%= row[:from_turn] %></td>
          <td><%= row[:until_turn] || "ongoing" %></td>
          <td><%= row[:origin] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <h3>Influence Attribution</h3>
  <p class="note"><code>unexplained</code> covers gold gifts, quests and coups - none of them logged.</p>
  <table class="city-state-attribution">
    <thead>
      <tr>
        <th>Civ</th>
        <th>City-State</th>
        <th>Gain</th>
        <th>Decay</th>
        <th>Rigs</th>
        <th>Explained</th>
        <th>Unexplained</th>
        <th>Trade Routes</th>
        <th>Merchant Confederacy</th>
      </tr>
    </thead>
    <tbody>
      <% @city_state_attribution_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:city_state] %></td>
          <td><%= row[:gain] %></td>
          <td><%= row[:decay] %></td>
          <td><%= row[:rigs] %></td>
          <td><%= row[:explained] %></td>
          <td><%= row[:unexplained] %></td>
          <td><%= row[:cs_routes] %></td>
          <td><%= row[:merchant_confederacy] ? "Yes" : "No" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= section_heading("Key Moments", "key-moments") %>

<% if @key_moment_groups.empty? %>
  <p class="empty-state">No key moments detected yet.</p>
<% end %>

<% @key_moment_groups.each do |group| %>
  <details class="moments">
    <summary><%= group[:title] %> (<%= group[:count] %>)</summary>
    <% group[:lists].each do |list| %>
      <% if list[:title] %>
        <h3><%= list[:title] %></h3>
      <% end %>
      <ul>
        <% list[:moments].each do |moment| %>
          <li>
            <%= key_moment_trend(moment) %><%= key_moment_sentence(moment) %>
            <% if (details = key_moment_details(moment)).present? %>
              <ul class="moment-detail">
                <% details.each do |detail| %>
                  <li><%= detail %></li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </details>
<% end %>
