<%= link_to "&laquo; All games".html_safe, games_path, class: "back-link" %>

<h1><%= @game.name %></h1>
<p class="subtitle">
  <%= @game.map_script %> &middot; <%= @game.map_size %> &middot; <%= @game.game_speed %> &middot;
  max turns: <%= @game.max_turns %>
</p>
<p><%= link_to "View raw event data", game_events_path(@game) %></p>

<h2>Outcome</h2>
<p>
  <% if @outcome[:victory_type] == "scrapped" %>
    <strong>Scrapped</strong> &mdash; abandoned by vote, no winner
    <span class="badge"><%= outcome_source_label(@outcome[:source]) %></span>
  <% elsif @outcome[:winner_civ] %>
    <strong><%= outcome_winner_names(@game, @outcome) %></strong>
    <%= "(#{@outcome[:victory_type]})" if @outcome[:victory_type] %>
    <span class="badge"><%= outcome_source_label(@outcome[:source]) %></span>
  <% else %>
    No leader yet.
  <% end %>
  <span class="badge<%= " badge--analyzed" unless @outcome[:in_progress] %>">
    <%= @outcome[:in_progress] ? "in progress" : "complete" %>
  </span>
</p>

<h2>Final Standings</h2>
<% if @standings.empty? %>
  <p class="empty-state">No snapshots yet.</p>
<% else %>
  <ol>
    <% @standings.each do |civ| %>
      <li><%= civ %></li>
    <% end %>
  </ol>
<% end %>

<%= section_heading("Capital Distances", "capital-distances") %>
<% if @capital_positions.any? %>
  <svg class="capital-layout" viewBox="0 0 <%= @capital_layout_width %> <%= @capital_layout_height %>" role="img" aria-label="Capital positions">
    <% @capital_positions.each do |point| %>
      <g class="<%= point[:major] ? "capital--major" : "capital--minor" %>">
        <circle cx="<%= point[:cx] %>" cy="<%= point[:cy] %>" r="<%= point[:major] ? 7 : 4 %>" />
        <text x="<%= point[:cx] %>" y="<%= point[:cy] - 12 %>"><%= point[:civ] %></text>
      </g>
    <% end %>
  </svg>
<% end %>
<% if @capital_distances.empty? %>
  <p class="empty-state">No capital coordinates in this game's events.</p>
<% else %>
  <table class="capital-distances">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Civ</th>
        <th>Hexes apart</th>
      </tr>
    </thead>
    <tbody>
      <% @capital_distances.each do |pair| %>
        <tr>
          <td><%= pair[:civs].first %></td>
          <td><%= pair[:civs].last %></td>
          <td><%= pair[:distance] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @map_bounds.estimated? %>
    <p><span class="badge">map width estimated</span> distances across the map's edge may be shorter than shown</p>
  <% end %>
<% end %>

<%= section_heading("Buffer Cities", "buffer-cities") %>
<% if !@buffer_cities[:applicable] %>
  <p class="empty-state">Buffer cities are only computed for Pangaea maps.</p>
<% elsif @buffer_cities[:pairs].empty? %>
  <p class="empty-state">No two capitals started within <%= @buffer_cities[:neighbour_distance] %> hexes.</p>
<% else %>
  <p class="note">
    Founded by turn <%= @buffer_cities[:window_turn] %>; neighbours within
    <%= @buffer_cities[:neighbour_distance] %> hexes, corridor city up to
    <%= @buffer_cities[:lateral_tolerance] %> hexes off the line between them.
  </p>
  <table class="buffer-cities">
    <thead>
      <tr>
        <th>Pair</th>
        <th>Apart</th>
        <th>Civ</th>
        <th>Buffer</th>
        <th>Founded</th>
        <th>City #</th>
        <th>Capital pop</th>
        <th>Reach before</th>
        <th>Detour</th>
        <th>From own</th>
        <th>From rival</th>
      </tr>
    </thead>
    <tbody>
      <% @buffer_cities[:pairs].each do |pair| %>
        <% pair[:civs].each_with_index do |civ, index| %>
          <% buffer = pair[:buffers][civ] %>
          <tr>
            <% if index.zero? %>
              <% span = pair[:civs].size %>
              <td rowspan="<%= span %>"><%= pair[:civs].first %> &ndash; <%= pair[:civs].last %></td>
              <td rowspan="<%= span %>"><%= pair[:distance] %></td>
            <% end %>
            <td><%= civ %></td>
            <td><%= buffer&.dig(:city) || "&mdash;".html_safe %></td>
            <td>
              <%= buffer&.dig(:turn) || "&mdash;".html_safe %>
              <% if pair[:settled_first] == civ %>
                <span class="badge">first</span>
              <% end %>
            </td>
            <td><%= buffer&.dig(:order) || "&mdash;".html_safe %></td>
            <td><%= buffer&.dig(:capital_population) || "&mdash;".html_safe %></td>
            <td><%= buffer&.dig(:reach_before) || "&mdash;".html_safe %></td>
            <td><%= buffer&.dig(:detour) || "&mdash;".html_safe %></td>
            <td><%= buffer&.dig(:from_own_capital) || "&mdash;".html_safe %></td>
            <td><%= buffer&.dig(:from_rival_capital) || "&mdash;".html_safe %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
  <% @buffer_cities[:priority].each do |civ, rivals| %>
    <p><%= civ %> secured its corridors in this order: <%= rivals.join(", ") %>.</p>
  <% end %>
<% end %>

<%= section_heading("Wonder Races", "wonder-races") %>
<% if !@wonder_races[:applicable] %>
  <p class="empty-state">Wonder races need per-city snapshots, which this game's log does not carry.</p>
<% elsif @wonder_races[:races].empty? %>
  <p class="empty-state">No world wonder in this game was contested by more than one city.</p>
<% else %>
  <p class="note">
    A race is every world wonder more than one city was building. A contender
    <strong>lost</strong> it if still building on the turn it fell, and
    <strong>abandoned</strong> it if it had moved on earlier.
  </p>
  <table class="wonder-races">
    <thead>
      <tr>
        <th>Wonder</th>
        <th>Done</th>
        <th>Won by</th>
        <th>Finish</th>
        <th>Lost by</th>
        <th>Turns on it</th>
        <th>Production in</th>
        <th>Turns left</th>
        <th>Outcome</th>
      </tr>
    </thead>
    <tbody>
      <% @wonder_races[:races].each do |race| %>
        <% race[:contenders].each_with_index do |contender, index| %>
          <tr>
            <% if index.zero? %>
              <% span = race[:contenders].size %>
              <td rowspan="<%= span %>"><%= race[:wonder_name] %></td>
              <td rowspan="<%= span %>"><%= race[:completed_turn] %></td>
              <td rowspan="<%= span %>"><%= race[:winner][:civ] %> (<%= race[:winner][:city] %>)</td>
              <td rowspan="<%= span %>"><%= race[:winner_finish].to_s.tr("_", " ") %></td>
            <% end %>
            <td><%= contender[:civ] %> (<%= contender[:city] %>)</td>
            <td><%= contender[:turns_building] %></td>
            <td><%= contender[:production_invested] %></td>
            <td><%= contender[:turns_left_when_last_seen] || "&mdash;".html_safe %></td>
            <td><%= contender[:outcome] %></td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= section_heading("Empire Geometry", "empire-geometry") %>
<% if @geometry_rows.empty? %>
  <p class="empty-state">No city coordinates in this game's events.</p>
<% else %>
  <table class="geometry">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Cities</th>
        <th>Span</th>
        <th>Spacing</th>
        <th>Elongation</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @geometry_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:cities] %></td>
          <td><%= row[:span] || "&mdash;".html_safe %></td>
          <td><%= row[:mean_spacing] || "&mdash;".html_safe %></td>
          <td><%= row[:elongation] || "&mdash;".html_safe %></td>
          <td>
            <% if row[:mismatch] %>
              <span class="badge">approximate from turn <%= row[:mismatch][:turn] %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See how these shapes came about", game_geometry_path(@game) %></p>
<% end %>

<%= section_heading("Early Game", "early-game") %>
<% if @early_game_rows.empty? %>
  <p class="empty-state">No players in this game.</p>
<% else %>
  <p class="note">Deadline: turn <%= @early_game_deadline_turn %> (<%= @game.game_speed %>).</p>
  <table class="early-game">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Ends Turn</th>
        <th>Why</th>
        <th>Milestone</th>
        <th>Tech</th>
        <th>Building</th>
      </tr>
    </thead>
    <tbody>
      <% @early_game_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:end_turn] %></td>
          <td><%= row[:reason] %></td>
          <td><%= early_game_milestone(row) || "&mdash;".html_safe %></td>
          <td><%= row[:tech_turn] || "&mdash;".html_safe %></td>
          <td><%= row[:building_turn] || "&mdash;".html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<%= section_heading("Military", "military") %>
<% if @army_rows.empty? %>
  <p class="empty-state">No military data in this game's snapshots.</p>
<% else %>
  <table class="army">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Turn</th>
        <th>Units</th>
        <th>Might</th>
        <th>Power</th>
        <th>Power per unit</th>
      </tr>
    </thead>
    <tbody>
      <% @army_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:turn] %></td>
          <td><%= row[:units] || "&mdash;".html_safe %></td>
          <td><%= row[:might] || "&mdash;".html_safe %></td>
          <td><%= row[:army_power] || "&mdash;".html_safe %></td>
          <td><%= row[:power_per_unit] || "&mdash;".html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See how these armies were built", game_army_path(@game) %></p>
<% end %>

<%= section_heading("Cultural Standing", "cultural-standing") %>
<% if @cultural_rows.empty? %>
  <p class="empty-state">No tourism data in this game's snapshots.</p>
<% else %>
  <table class="cultural">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Tourism</th>
        <th>Civs Influential On</th>
        <th>Influential/Dominant On</th>
      </tr>
    </thead>
    <tbody>
      <% @cultural_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:tourism] || "&mdash;".html_safe %></td>
          <td><%= row[:civs_influential_on] || "&mdash;".html_safe %></td>
          <td><%= row[:influential_on].presence&.join(", ") || "&mdash;".html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See how cultural standing changed over time", game_cultural_path(@game) %></p>
<% end %>

<%= section_heading("World Congress", "world-congress") %>
<% if @congress_summary.nil? %>
  <p class="empty-state">No World Congress data in this game's events.</p>
<% else %>
  <p class="meta">
    Host: <strong><%= @congress_summary[:host] || "none yet" %></strong>
    &middot; Votes needed for diplomatic victory: <strong><%= @congress_summary[:votes_needed] || "unknown" %></strong>
  </p>
  <table class="congress">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Delegate Votes</th>
      </tr>
    </thead>
    <tbody>
      <% @congress_summary[:rows].each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:votes] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See host changes, votes and resolutions over time", game_congress_path(@game) %></p>
<% end %>

<%= section_heading("Victory Progress", "victory-progress") %>
<% if @victory_progress_rows.empty? %>
  <p class="empty-state">No domination or space-race data in this game's snapshots.</p>
<% else %>
  <table class="victory-progress">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Capitals Held</th>
        <th>Spaceship Parts</th>
      </tr>
    </thead>
    <tbody>
      <% @victory_progress_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:capitals_held] || "&mdash;".html_safe %></td>
          <td><%= row[:parts_assembled] ? "#{row[:parts_assembled]} / 6" : "&mdash;".html_safe %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See capitals and spaceship assembly over time", game_victory_progress_path(@game) %></p>
<% end %>

<%= section_heading("Key Moments", "key-moments") %>

<% if @key_moment_groups.empty? %>
  <p class="empty-state">No key moments detected yet.</p>
<% end %>

<% @key_moment_groups.each do |group| %>
  <details class="moments">
    <summary><%= group[:title] %> (<%= group[:count] %>)</summary>
    <% group[:lists].each do |list| %>
      <% if list[:title] %>
        <h3><%= list[:title] %></h3>
      <% end %>
      <ul>
        <% list[:moments].each do |moment| %>
          <li>
            <%= key_moment_trend(moment) %><%= key_moment_sentence(moment) %>
            <% if (details = key_moment_details(moment)).present? %>
              <ul class="moment-detail">
                <% details.each do |detail| %>
                  <li><%= detail %></li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </details>
<% end %>

<%= section_heading("Strategy Report", "strategy-report") %>
<% if @latest_analysis %>
  <p class="meta">
    Model: <%= @latest_analysis.model %> &middot; generated <%= @latest_analysis.created_at.strftime("%Y-%m-%d %H:%M") %>
    <% if @latest_analysis.input_tokens && @latest_analysis.output_tokens %>
      &middot; <%= @latest_analysis.input_tokens %> in + <%= @latest_analysis.output_tokens %> out tokens
      <% if @latest_analysis.cost_usd %>
        (~$<%= format("%.4f", @latest_analysis.cost_usd) %>)
      <% end %>
    <% end %>
  </p>
  <p><%= link_to "View all #{pluralize(@game.analyses.count, "analysis", plural: "analyses")}", game_analyses_path(@game) %></p>
  <div class="report"><%= render_markdown(@latest_analysis.report) %></div>
<% else %>
  <p class="empty-state">Not analyzed yet. Run <code>bin/civ analyze <%= @game.id %></code>.</p>
<% end %>
