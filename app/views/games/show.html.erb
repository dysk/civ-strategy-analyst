<%= link_to "&laquo; All games".html_safe, games_path, class: "back-link" %>

<h1><%= @game.name %></h1>
<p class="subtitle">
  <%= @game.map_script %> &middot; <%= @game.map_size %> &middot; <%= @game.game_speed %> &middot;
  max turns: <%= @game.max_turns %>
</p>
<p><%= link_to "View raw event data", game_events_path(@game) %></p>

<h2>Outcome</h2>
<p>
  <% if @outcome[:winner_civ] %>
    <strong><%= @outcome[:winner_civ] %></strong>
    <%= "(#{@outcome[:victory_type]})" if @outcome[:victory_type] %>
    <span class="badge"><%= @outcome[:source] == :inferred ? "inferred leader" : "declared winner" %></span>
  <% else %>
    No leader yet.
  <% end %>
  <span class="badge<%= " badge--analyzed" unless @outcome[:in_progress] %>">
    <%= @outcome[:in_progress] ? "in progress" : "complete" %>
  </span>
</p>

<h2>Final Standings</h2>
<% if @standings.empty? %>
  <p class="empty-state">No snapshots yet.</p>
<% else %>
  <ol>
    <% @standings.each do |civ| %>
      <li><%= civ %></li>
    <% end %>
  </ol>
<% end %>

<h2>Empire Geometry</h2>
<% if @geometry_rows.empty? %>
  <p class="empty-state">No city coordinates in this game's events.</p>
<% else %>
  <table class="geometry">
    <thead>
      <tr>
        <th>Civ</th>
        <th>Cities</th>
        <th>Span</th>
        <th>Spacing</th>
        <th>Elongation</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @geometry_rows.each do |row| %>
        <tr>
          <td><%= row[:civ] %></td>
          <td><%= row[:cities] %></td>
          <td><%= row[:span] || "&mdash;".html_safe %></td>
          <td><%= row[:mean_spacing] || "&mdash;".html_safe %></td>
          <td><%= row[:elongation] || "&mdash;".html_safe %></td>
          <td>
            <% if row[:mismatch] %>
              <span class="badge">approximate from turn <%= row[:mismatch][:turn] %></span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p><%= link_to "See how these shapes came about", game_geometry_path(@game) %></p>
<% end %>

<h2>Key Moments</h2>

<% if @key_moment_groups.empty? %>
  <p class="empty-state">No key moments detected yet.</p>
<% end %>

<% @key_moment_groups.each do |group| %>
  <details class="moments">
    <summary><%= group[:title] %> (<%= group[:count] %>)</summary>
    <% group[:lists].each do |list| %>
      <% if list[:title] %>
        <h3><%= list[:title] %></h3>
      <% end %>
      <ul>
        <% list[:moments].each do |moment| %>
          <li><%= key_moment_trend(moment) %><%= key_moment_sentence(moment) %></li>
        <% end %>
      </ul>
    <% end %>
  </details>
<% end %>

<h2>Strategy Report</h2>
<% if @latest_analysis %>
  <p class="meta">
    Model: <%= @latest_analysis.model %> &middot; generated <%= @latest_analysis.created_at.strftime("%Y-%m-%d %H:%M") %>
    <% if @latest_analysis.input_tokens && @latest_analysis.output_tokens %>
      &middot; <%= @latest_analysis.input_tokens %> in + <%= @latest_analysis.output_tokens %> out tokens
      <% if @latest_analysis.cost_usd %>
        (~$<%= format("%.4f", @latest_analysis.cost_usd) %>)
      <% end %>
    <% end %>
  </p>
  <p><%= link_to "View all #{pluralize(@game.analyses.count, "analysis", plural: "analyses")}", game_analyses_path(@game) %></p>
  <div class="report"><%= render_markdown(@latest_analysis.report) %></div>
<% else %>
  <p class="empty-state">Not analyzed yet. Run <code>bin/civ analyze <%= @game.id %></code>.</p>
<% end %>
