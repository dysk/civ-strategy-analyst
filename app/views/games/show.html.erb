<%= link_to "&laquo; All games".html_safe, games_path, class: "back-link" %>

<h1><%= @game.name %></h1>
<p class="subtitle">
  <%= @game.map_script %> &middot; <%= @game.map_size %> &middot; <%= @game.game_speed %> &middot;
  max turns: <%= @game.max_turns %>
</p>

<h2>Outcome</h2>
<p>
  <% if @outcome[:winner_civ] %>
    <strong><%= @outcome[:winner_civ] %></strong>
    <%= "(#{@outcome[:victory_type]})" if @outcome[:victory_type] %>
    <span class="badge"><%= @outcome[:source] == :inferred ? "inferred leader" : "declared winner" %></span>
  <% else %>
    No leader yet.
  <% end %>
  <span class="badge<%= " badge--analyzed" unless @outcome[:in_progress] %>">
    <%= @outcome[:in_progress] ? "in progress" : "complete" %>
  </span>
</p>

<h2>Final Standings</h2>
<% if @standings.empty? %>
  <p class="empty-state">No snapshots yet.</p>
<% else %>
  <ol>
    <% @standings.each do |civ| %>
      <li><%= civ %></li>
    <% end %>
  </ol>
<% end %>

<h2>Key Moments</h2>

<% if [
     @key_moments.wars, @key_moments.leader_changes, @key_moments.era_leads,
     @key_moments.religion_foundings, @key_moments.military_might_collapses,
     @key_moments.snowballs("score"), @key_moments.nuclear_detonations,
     @key_moments.city_state_ally_takeovers
   ].all?(&:empty?) %>
  <p class="empty-state">No key moments detected yet.</p>
<% end %>

<% if @key_moments.wars.any? %>
  <h3>Wars</h3>
  <ul>
    <% @key_moments.wars.each do |war| %>
      <li>
        Turn <%= war[:turn] %>: <%= war[:attacker_civs].join(", ") %> declared war on <%= war[:defender_civs].join(", ") %>
        <%= war[:turn_peace] ? "(peace at turn #{war[:turn_peace]})" : "(ongoing)" %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if @key_moments.leader_changes.any? %>
  <h3>Leader Changes</h3>
  <ul>
    <% @key_moments.leader_changes.each do |change| %>
      <li>Turn <%= change[:turn] %>: <%= change[:metric] %> lead passed from <%= change[:from] %> to <%= change[:to] %></li>
    <% end %>
  </ul>
<% end %>

<% if @key_moments.era_leads.any? %>
  <h3>Era Leads</h3>
  <ul>
    <% @key_moments.era_leads.each do |lead| %>
      <li>Turn <%= lead[:turn] %>: <%= lead[:civs].join(", ") %> reached <%= lead[:era] %> first</li>
    <% end %>
  </ul>
<% end %>

<% if @key_moments.religion_foundings.any? %>
  <h3>Religion Foundings</h3>
  <ul>
    <% @key_moments.religion_foundings.each do |founding| %>
      <li>Turn <%= founding[:turn] %>: <%= founding[:civ] %> founded <%= founding[:religion] %> (##<%= founding[:order] %>)</li>
    <% end %>
  </ul>
<% end %>

<% if @key_moments.military_might_collapses.any? %>
  <h3>Military Might Collapses</h3>
  <ul>
    <% @key_moments.military_might_collapses.each do |collapse| %>
      <li>Turn <%= collapse[:turn] %>: <%= collapse[:civ] %> military might dropped from <%= collapse[:from] %> to <%= collapse[:to] %></li>
    <% end %>
  </ul>
<% end %>

<% if @key_moments.snowballs("score").any? %>
  <h3>Snowballs (Score)</h3>
  <ul>
    <% @key_moments.snowballs("score").each do |snowball| %>
      <li>Turns <%= snowball[:turn] %>&ndash;<%= snowball[:turn_end] %>: <%= snowball[:civ] %> pulled decisively ahead</li>
    <% end %>
  </ul>
<% end %>

<% if @key_moments.nuclear_detonations.any? %>
  <h3>Nuclear Detonations</h3>
  <ul>
    <% @key_moments.nuclear_detonations.each do |detonation| %>
      <li>Turn <%= detonation[:turn] %>: <%= detonation[:civ] %> detonated a nuclear weapon on <%= detonation[:city] %></li>
    <% end %>
  </ul>
<% end %>

<% if @key_moments.city_state_ally_takeovers.any? %>
  <h3>City-State Ally Takeovers</h3>
  <ul>
    <% @key_moments.city_state_ally_takeovers.each do |takeover| %>
      <li>Turn <%= takeover[:turn] %>: <%= takeover[:to] %> took <%= takeover[:city_state] %>'s alliance from <%= takeover[:from] %></li>
    <% end %>
  </ul>
<% end %>

<h2>Strategy Report</h2>
<% if @latest_analysis %>
  <p class="meta">
    Model: <%= @latest_analysis.model %> &middot; generated <%= @latest_analysis.created_at.strftime("%Y-%m-%d %H:%M") %>
    <% if @latest_analysis.input_tokens && @latest_analysis.output_tokens %>
      &middot; <%= @latest_analysis.input_tokens %> in + <%= @latest_analysis.output_tokens %> out tokens
      <% if @latest_analysis.cost_usd %>
        (~$<%= format("%.4f", @latest_analysis.cost_usd) %>)
      <% end %>
    <% end %>
  </p>
  <div class="report"><%= render_markdown(@latest_analysis.report) %></div>
<% else %>
  <p class="empty-state">Not analyzed yet. Run <code>bin/civ analyze <%= @game.id %></code>.</p>
<% end %>
