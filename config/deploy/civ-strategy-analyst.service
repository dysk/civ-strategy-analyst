[Unit]
Description=civ-strategy-analyst Puma server
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/civ-strategy-analyst

# Loads DATABASE/API secrets; RAILS_ENV is set here rather than in the file
# itself so the same .env.production works if we ever add a staging target.
EnvironmentFile=/home/deploy/civ-strategy-analyst/.env.production
Environment=RAILS_ENV=production

# Owned by User=, group-writable so Nginx (group www-data) can reach the socket.
RuntimeDirectory=civ-strategy-analyst
RuntimeDirectoryMode=0750

ExecStart=/home/deploy/.rbenv/shims/bundle exec puma -C config/puma.rb
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
